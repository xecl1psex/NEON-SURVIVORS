```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
dist/
build/
*.class
*.exe
*.dll
*.so
*.a
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Editors
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Python specific
*.pyo
*.pyd
*.egg-info/
.Python
*.so

# JavaScript/Node specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java specific
*.jar
*.war
*.ear
hs_err_pid*

# C/C++ specific
*.a
*.la
*.lo
*.i
*.ii

# Go specific
*.exe
*.test
*.prof

# Ruby specific
*.gem
*.rbc
*.sass-cache

# Rust specific
*.rlib

# Gradle
.gradle/
build/

# Maven
target/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# PyTest
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Temporary folders
tmp/
temp/
```